# Internal OpenAI-compatible completion, OAuth2, and exact tokenizer endpoints.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_TOKEN_URL=
LLM_GATEWAY_CHAT_PATH=/chat/completions
LLM_GATEWAY_TOKENIZER_PATH=/tokenize/chat

# Both credential slots, when present, must resolve exactly gpt-5.4-mini.
LLM_GATEWAY_CLIENT_ID_1=
LLM_GATEWAY_CLIENT_SECRET_1=
LLM_GATEWAY_MODELS_1=gpt-5.4-mini
LLM_GATEWAY_CLIENT_ID_2=
LLM_GATEWAY_CLIENT_SECRET_2=
LLM_GATEWAY_MODELS_2=gpt-5.4-mini

# Frozen exact tokenizer identity returned by the tokenizer endpoint.
GATEWAY_TOKENIZER_ID=
GATEWAY_TOKENIZER_SHA256=

# Exact separately acquired local source snapshot hashes.
FINQA_SOURCE_SHA256=
TATQA_SOURCE_SHA256=
FINANCE_COMPLEX_SOURCE_SHA256=

# Per-credential hard ceiling; the CUBIC controller adapts below this value.
LLM_GATEWAY_CONCURRENCY_PER_KEY=12
