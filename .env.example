# Internal OpenAI-compatible gateway and OAuth2 token endpoints.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_TOKEN_URL=
LLM_GATEWAY_SCOPE=

# Credential pair 1: GPT and Claude deployments.
LLM_GATEWAY_CLIENT_ID_1=
LLM_GATEWAY_CLIENT_SECRET_1=
LLM_GATEWAY_MODELS_1=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,claude-opus-4-6,claude-sonnet-4-6

# Credential pair 2: GPT deployments only.
LLM_GATEWAY_CLIENT_ID_2=
LLM_GATEWAY_CLIENT_SECRET_2=
LLM_GATEWAY_MODELS_2=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano

# Hard ceiling for each credential. A per-credential CUBIC controller starts at
# min(4, ceiling), probes upward on success, and backs off on overload/429s.
LLM_GATEWAY_CONCURRENCY_PER_KEY=4

# Experiment roles. Set these to the exact internal deployment IDs.
GATEWAY_MODEL_GENERATOR=gpt-5.4-mini
GATEWAY_MODEL_VERIFIER=gpt-5.4
GATEWAY_MODEL_JUDGE_A=gpt-5.4
GATEWAY_MODEL_JUDGE_B=claude-sonnet-4-6
GATEWAY_MODEL_ADJUDICATOR=claude-opus-4-6
