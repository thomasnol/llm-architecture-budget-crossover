# Internal OpenAI-compatible gateway and OAuth2 token endpoints.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_TOKEN_URL=

# Credential pair 1: GPT and Claude deployments.
LLM_GATEWAY_CLIENT_ID_1=
LLM_GATEWAY_CLIENT_SECRET_1=
LLM_GATEWAY_MODELS_1=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,claude-opus-4-6,claude-sonnet-4-6

# Credential pair 2: GPT deployments only.
LLM_GATEWAY_CLIENT_ID_2=
LLM_GATEWAY_CLIENT_SECRET_2=
LLM_GATEWAY_MODELS_2=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano

# Per-credential hard ceiling; the CUBIC controller adapts below this value.
LLM_GATEWAY_CONCURRENCY_PER_KEY=12

# Experimental roles.
GATEWAY_MODEL_PRIMARY=gpt-5.4-mini
GATEWAY_MODEL_SUPERVISOR=claude-sonnet-4-6
