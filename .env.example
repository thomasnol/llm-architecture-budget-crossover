# OpenAI-compatible gateway endpoint, for example:
# https://gateway.example.internal/v1
LLM_GATEWAY_BASE_URL=

# Static bearer-key mode. The scheduler treats each key as a separate
# four-request concurrency pool. Do not commit the real values.
LLM_GATEWAY_API_KEY_1=
LLM_GATEWAY_API_KEY_2=
LLM_GATEWAY_CONCURRENCY_PER_KEY=4
LLM_GATEWAY_MODELS_1=*
LLM_GATEWAY_MODELS_2=gpt-*
LLM_GATEWAY_API_KEY_HEADER=Authorization
LLM_GATEWAY_API_KEY_PREFIX=Bearer 
LLM_GATEWAY_CHAT_PATH=/chat/completions
LLM_GATEWAY_MAX_TOKENS_FIELD=max_tokens

# Optional OAuth2 client-credentials mode. Leave blank when using bearer keys.
LLM_GATEWAY_TOKEN_URL=
LLM_GATEWAY_CLIENT_ID_1=
LLM_GATEWAY_CLIENT_SECRET_1=
LLM_GATEWAY_CLIENT_ID_2=
LLM_GATEWAY_CLIENT_SECRET_2=
LLM_GATEWAY_SCOPE=
LLM_GATEWAY_OAUTH_BASIC_AUTH=false

# Override these only if the gateway uses different deployment identifiers.
GATEWAY_MODEL_GENERATOR=gpt-5.4-mini
GATEWAY_MODEL_VERIFIER=gpt-5.4
GATEWAY_MODEL_JUDGE_A=gpt-5.4
GATEWAY_MODEL_JUDGE_B=claude-sonnet-4-6
GATEWAY_MODEL_ADJUDICATOR=claude-opus-4-6

# Optional compatibility headers as a JSON object.
LLM_GATEWAY_EXTRA_HEADERS={}
